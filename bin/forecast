#!/usr/bin/env python3
"""
FORECAST - Unified Command-Line Interface Wrapper
Delegates to forecast.cli.main()
"""

import sys
from pathlib import Path

# Ensure local repository root is available in sys.path when running from checkout
_repo_root = Path(__file__).resolve().parent.parent
if str(_repo_root) not in sys.path and (_repo_root / "forecast").is_dir():
    sys.path.insert(0, str(_repo_root))

from forecast.cli import main

if __name__ == "__main__":
    main()
